# Skopíruj tento súbor ako db.properties (do priečinka, odkiaľ spúšťaš aplikáciu).
# Hodnoty sa len predvyplnia v prihlasovacom okne; heslo sa nikdy neukladá.
#
# Oracle XE / Free (lokálne):       jdbc:oracle:thin:@//localhost:1521/XEPDB1
# Oracle XE 11g (SID):              jdbc:oracle:thin:@localhost:1521:XE
# Školský server (príklad):         jdbc:oracle:thin:@//server.skola.sk:1521/orcl
url=jdbc:oracle:thin:@//localhost:1521/XEPDB1
user=autoservis
